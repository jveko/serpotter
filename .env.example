# Serpotter API
# These must be in the process environment — cargo does not load this file.
# Load with: set -a; source .env; set +a
DATABASE_URL=sqlite:data/serpotter.db?mode=rwc
PORT=8080
RUST_LOG=info,serpotter_api=debug
# LOG_FORMAT=json
ENVIRONMENT=development

# Admin SPA / API bootstrap secret (Bearer or X-Admin-Password)
# ADMIN_SECRET=change-me
# Optional: serve the built admin SPA at the site root (/). Registered as the
# router fallback, so /api /mcp /live /ready still win; unknown /api paths 404 JSON.
# Client routes (/stats, /keys, …) fall back to index.html, so refresh works.
# Build first: cd apps/admin && npm run build
# ADMIN_SPA_DIR=apps/admin/dist

# MCP Streamable HTTP (rmcp): Host allowlist for DNS-rebinding protection.
# Unset = loopback only (localhost, 127.0.0.1, ::1). Public VPS must list hostname(s).
# Empty value disables allowlist (not recommended).
# MCP_ALLOWED_HOSTS=search.example.com,search.example.com:8080

# MCP Origin allowlist (2026-07-28 spec: Origin validated when the header is
# present and this is set). Unset = rmcp default (validation disabled). Set for
# browser-origin MCP clients, e.g. the MCP inspector served from a dev origin.
# MCP_ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173

# Optional provider base URLs
# TAVILY_BASE_URL=https://api.tavily.com
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# EXA_BASE_URL=https://api.exa.ai
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.5

# Outbound: configure proxies in admin Nodes (http|https|socks5).
# OUTBOUND_PROXY / HTTPS_PROXY / HTTP_PROXY are ignored by Serpotter (nodes-only pool).
# xAI always dials direct.
# Fail-closed when no enabled node (product → 503 NoHealthyNode):
# REQUIRE_OUTBOUND_PROXY=1
# NODE_HOLD_TTL_SECS=90

# Key pool shared soft cap (product path)
# KEY_MAX_INFLIGHT=3
# KEY_ACQUIRE_TIMEOUT_SECS=30
# KEY_HOLD_TTL_SECS=90
# KEY_UNKNOWN_CREDIT_WEIGHT=100

# Maintenance (15m loop): re-enable keys/nodes, high-error-rate alert, optional credit sync
# KEY_REENABLE_AFTER_HOURS=24
# NODE_REENABLE_AFTER_HOURS=24
# CREDIT_SYNC_CRON=0
# Set CREDIT_SYNC_CRON=1 or true to sync Tavily/Firecrawl credits each tick (off by default)

# Overall request deadline per search/extract/research call (REST 504 / MCP Timeout)
# REQUEST_TIMEOUT_SECS=120

# B1: exact-query TTL response cache (seconds; 0 disables). Default 300.
# CACHE_TTL_SECS=300
# B15: optional error-rate alert webhook (JSON {errorRate,total,errors,ts}) when
# the 5-minute request error rate (in-memory events window) exceeds 50% with >= 20 requests.
# ADMIN_ALERT_URL=
