# Serpotter API
# These must be in the process environment — cargo does not load this file.
# Load with: set -a; source .env; set +a
DATABASE_URL=sqlite:data/serpotter.db?mode=rwc
PORT=8080
RUST_LOG=info,serpotter_api=debug
ENVIRONMENT=development

# Admin SPA / API bootstrap secret (Bearer or X-Admin-Password)
# ADMIN_SECRET=change-me

# MCP Streamable HTTP (rmcp): Host allowlist for DNS-rebinding protection.
# Unset = loopback only (localhost, 127.0.0.1, ::1). Public VPS must list hostname(s).
# Empty value disables allowlist (not recommended).
# MCP_ALLOWED_HOSTS=search.example.com,search.example.com:8080

# Optional provider base URLs
# TAVILY_BASE_URL=https://api.tavily.com
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# EXA_BASE_URL=https://api.exa.ai
# XAI_BASE_URL=https://api.x.ai/v1

# Outbound HTTP(S) proxy for Tavily/Firecrawl/Exa (reqwest Proxy::all).
# xAI always dials direct. Also honors HTTPS_PROXY / HTTP_PROXY if OUTBOUND_PROXY unset.
# Non-empty Fixed env skips the `nodes` table. Blank falls through to live nodes / direct.
# OUTBOUND_PROXY=http://user:pass@127.0.0.1:7890

# Key pool shared soft cap (product path)
# KEY_MAX_INFLIGHT=3
# KEY_ACQUIRE_TIMEOUT_SECS=30
# KEY_HOLD_TTL_SECS=90
